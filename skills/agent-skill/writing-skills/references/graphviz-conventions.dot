digraph STYLE_GUIDE {
    // このプロセスDSLのスタイルガイド。DSL自身で記述している

    // ノード種別と形状の例
    subgraph cluster_node_types {
        label="ノード種別と形状";

        // 質問はひし形
        "これは質問か?" [shape=diamond];

        // アクションはボックス(デフォルト)
        "アクションを実行する" [shape=box];

        // コマンドはplaintext
        "git commit -m 'msg'" [shape=plaintext];

        // 状態は楕円
        "現在の状態" [shape=ellipse];

        // 警告は八角形
        "STOP: 重大な警告" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];

        // 開始・終了は二重丸
        "プロセス開始" [shape=doublecircle];
        "プロセス完了" [shape=doublecircle];

        // それぞれの例
        "テストは通っているか?" [shape=diamond];
        "先にテストを書く" [shape=box];
        "npm test" [shape=plaintext];
        "行き詰まった" [shape=ellipse];
        "git add -A は絶対に使わない" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
    }

    // エッジの命名規則
    subgraph cluster_edge_types {
        label="エッジのラベル";

        "二択の判断か?" [shape=diamond];
        "Yesの経路" [shape=box];
        "Noの経路" [shape=box];

        "二択の判断か?" -> "Yesの経路" [label="yes"];
        "二択の判断か?" -> "Noの経路" [label="no"];

        "複数の選択肢か?" [shape=diamond];
        "選択肢A" [shape=box];
        "選択肢B" [shape=box];
        "選択肢C" [shape=box];

        "複数の選択肢か?" -> "選択肢A" [label="条件A"];
        "複数の選択肢か?" -> "選択肢B" [label="条件B"];
        "複数の選択肢か?" -> "選択肢C" [label="それ以外"];

        "プロセスA完了" [shape=doublecircle];
        "プロセスB開始" [shape=doublecircle];

        "プロセスA完了" -> "プロセスB開始" [label="トリガーする", style=dotted];
    }

    // 命名パターン
    subgraph cluster_naming_patterns {
        label="命名パターン";

        // 質問は?で終わる
        "Xをすべきか?";
        "これはYになりうるか?";
        "Zは真か?";
        "Wは済んだか?";

        // アクションは動詞で始まる
        "テストを書く";
        "パターンを検索する";
        "変更をコミットする";
        "助けを求める";

        // コマンドはそのまま書く
        "grep -r 'pattern' .";
        "git status";
        "npm run build";

        // 状態は状況を表す
        "テストが失敗している";
        "ビルド完了";
        "エラーで行き詰まっている";
    }

    // プロセス構造のテンプレート
    subgraph cluster_structure {
        label="プロセス構造のテンプレート";

        "トリガー: 何かが起きる" [shape=ellipse];
        "最初の確認?" [shape=diamond];
        "メインのアクション" [shape=box];
        "git status" [shape=plaintext];
        "別の確認?" [shape=diamond];
        "代替のアクション" [shape=box];
        "STOP: これはやらない" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
        "プロセス完了" [shape=doublecircle];

        "トリガー: 何かが起きる" -> "最初の確認?";
        "最初の確認?" -> "メインのアクション" [label="yes"];
        "最初の確認?" -> "代替のアクション" [label="no"];
        "メインのアクション" -> "git status";
        "git status" -> "別の確認?";
        "別の確認?" -> "プロセス完了" [label="ok"];
        "別の確認?" -> "STOP: これはやらない" [label="問題あり"];
        "代替のアクション" -> "プロセス完了";
    }

    // どの形状をいつ使うか
    subgraph cluster_shape_rules {
        label="各形状を使う場面";

        "形状を選ぶ" [shape=ellipse];

        "判断か?" [shape=diamond];
        "ひし形を使う" [shape=diamond, style=filled, fillcolor=lightblue];

        "コマンドか?" [shape=diamond];
        "plaintextを使う" [shape=plaintext, style=filled, fillcolor=lightgray];

        "警告か?" [shape=diamond];
        "八角形を使う" [shape=octagon, style=filled, fillcolor=pink];

        "開始・終了か?" [shape=diamond];
        "二重丸を使う" [shape=doublecircle, style=filled, fillcolor=lightgreen];

        "状態か?" [shape=diamond];
        "楕円を使う" [shape=ellipse, style=filled, fillcolor=lightyellow];

        "デフォルト: ボックスを使う" [shape=box, style=filled, fillcolor=lightcyan];

        "形状を選ぶ" -> "判断か?";
        "判断か?" -> "ひし形を使う" [label="yes"];
        "判断か?" -> "コマンドか?" [label="no"];
        "コマンドか?" -> "plaintextを使う" [label="yes"];
        "コマンドか?" -> "警告か?" [label="no"];
        "警告か?" -> "八角形を使う" [label="yes"];
        "警告か?" -> "開始・終了か?" [label="no"];
        "開始・終了か?" -> "二重丸を使う" [label="yes"];
        "開始・終了か?" -> "状態か?" [label="no"];
        "状態か?" -> "楕円を使う" [label="yes"];
        "状態か?" -> "デフォルト: ボックスを使う" [label="no"];
    }

    // 良い例と悪い例
    subgraph cluster_examples {
        label="良い例と悪い例";

        // 良い例: 具体的で、形状が正しい
        "テストが失敗した" [shape=ellipse];
        "エラーメッセージを読む" [shape=box];
        "再現できるか?" [shape=diamond];
        "git diff HEAD~1" [shape=plaintext];
        "エラーを絶対に無視しない" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];

        "テストが失敗した" -> "エラーメッセージを読む";
        "エラーメッセージを読む" -> "再現できるか?";
        "再現できるか?" -> "git diff HEAD~1" [label="yes"];

        // 悪い例: 曖昧で、形状が誤っている
        bad_1 [label="何かがおかしい", shape=box];  // 楕円(状態)にすべき
        bad_2 [label="直す", shape=box];  // 曖昧すぎる
        bad_3 [label="確認する", shape=box];  // ひし形にすべき
        bad_4 [label="コマンドを実行する", shape=box];  // 実際のコマンドを書いたplaintextにすべき

        bad_1 -> bad_2;
        bad_2 -> bad_3;
        bad_3 -> bad_4;
    }
}